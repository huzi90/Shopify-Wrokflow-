<div class="builder {% if section.settings.builder == "sticky" %}builder-sticky{% else %}builder-grid{% endif %} ">
    {% if section.settings.builder == "builder-grid" %}
    <div class="custom-grid 
            {% if section.settings.grid == "grid-two" %}
            grid-two 
            {% elsif section.settings.grid == "grid-three" %}
            grid-three 
            {% elsif section.settings.grid == "grid-four" %}
            grid-four
    {% endif %}">
    <div class="inner-products"></div>
    </div>
    {%  else  %}
         <div class="custom-sticky">
        <div class="inner-products"></div>
    </div>
    {% endif %}
</div>
{%  schema %}
{
    "name":"Grid",
    "settings": [
        {
            "type": "select",
            "id": "builder",
            "label": "Select the builder layout.",
            "options": [
                {
                    "value": "sticky",
                    "label":"Sticky"
                },
                {
                    "value": "builder-grid",
                    "label":"Grid"
                }
            ]
        },
        {
            "type": "select",
            "id":"grid",
            "label": "Select the media layout.",
            "options": [
                {
                    "value": "grid-two",
                    "label":"Two"
                },
                {
                    "value": "grid-three",
                    "label":"Three"
                },
                {
                    "value": "grid-four",
                    "label":"Four"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Grid"
        }
    ]
}
{% endschema %}